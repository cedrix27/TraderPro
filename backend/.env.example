# Binance API Configuration
# Obtenir les clés sur: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Pour le testnet (recommandé pour commencer)
# https://testnet.binance.vision/
BINANCE_TESTNET=true
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=
FUTURES_LEVERAGE=1


# Application
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8002

# Database (optionnel)
DATABASE_URL=sqlite:///./data/traderpro.db

# Autonomous Futures Testnet trader. Leave false until you explicitly want it running.
AUTONOMOUS_TRADING_ENABLED=false
AUTONOMOUS_SYMBOL=BTCUSDT
AUTONOMOUS_TRADE_AMOUNT_USDT=60
AUTONOMOUS_MAX_DAILY_LOSS_USDT=20
AUTONOMOUS_MAX_TRADES_PER_DAY=4
AUTONOMOUS_MIN_CONFIDENCE=55
AUTONOMOUS_SCHEDULER_SECONDS=300


